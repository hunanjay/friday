# Switch the entire LLM profile with one value: qwen, zhipu, or custom.
# Restart/recreate the backend after changing it so cached model clients reset.
LLM_PROVIDER=custom

# Alibaba Cloud Model Studio (recommended for reliable agent tool calling).
# The workspace URL must end in /compatible-mode/v1, not /api/v1.
QWEN_API_KEY=
QWEN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash
# Optional profile overrides; defaults shown here.
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_API_KEY=

# Zhipu GLM (glm-4-flash is free, but its tool-calling conformance is weaker).
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4-flash
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_BASE_URL=
ZHIPU_EMBEDDING_API_KEY=

# Generic OpenAI-compatible fallback, used only when LLM_PROVIDER=custom.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLE_THINKING=

# Shared optional overrides for the custom profile. Qwen and Zhipu use their
# profile-specific embedding variables above.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
SUPABASE_URL=https://sbqgivaqomoyobfamwxt.supabase.co
SUPABASE_ANON_KEY=
# service_role key - server-only, never expose to the frontend. Found in
# Supabase dashboard under Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret - used to verify tokens locally without hitting Supabase API on every request.
# Found in Supabase dashboard under Project Settings > API.
SUPABASE_JWT_SECRET=
# Same Azure AD app registration configured in Supabase's Azure provider
# settings - needed to silently refresh the Microsoft Graph token.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Postgres used to store LangGraph agent conversation state (checkpointer),
# separate from Supabase. `docker compose up` provides this automatically -
# for bare `uvicorn` dev without Docker, point this at a local Postgres instead.
CHECKPOINT_DB_URL=postgresql://friday:friday@db:5432/friday
# Qdrant Cloud cluster used for hybrid (dense + BM25) search over memos.
# Create a free cluster at https://cloud.qdrant.io and copy its URL + API key.
# When running via docker-compose, QDRANT_URL is injected automatically as
# http://qdrant:6333 - only set this for an external/cloud cluster.
QDRANT_URL=
QDRANT_API_KEY=
# Repo the github_agent reports on (owner/name).
GITHUB_REPORT_REPO=hunanjay/friday
# GitHub OAuth App used for connecting a user's GitHub account (a raw OAuth
# 2.0 flow handled entirely by this backend - api/github_auth.py's /connect
# + /callback - NOT Supabase's `github` provider, which only verifies an
# identity for login and doesn't hand back a usable API token). Register at
# github.com > Settings > Developer settings > OAuth Apps; callback URL is
# BACKEND_URL below + /api/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Used to build the GitHub OAuth callback/redirect URLs. Defaults below match
# local dev (`docker compose up` + `npm run dev`); override for prod.
BACKEND_URL=http://localhost:8005
FRONTEND_URL=http://localhost:3005
# IANA timezone name used by the calendar and daily-report agents to resolve
# "today", "tomorrow", etc. against the correct local date. Defaults to
# Asia/Shanghai (UTC+8, no DST) if unset.
TIMEZONE=Asia/Shanghai
# Dev-only: set to true to skip the SSRF host check when binding mail accounts
# (app/infrastructure/mail/ssrf.py). Only needed if a local proxy's Fake-IP
# DNS mode resolves real mail hosts into a blocked reserved range. Never set
# this in production.
MAIL_SSRF_CHECK_DISABLED=false
# Fernet key used to encrypt IMAP/SMTP credentials for bound mail accounts
# (app/infrastructure/security/crypto.py). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=
# Aliyun OSS - optional. Without these, memo attachments (services/storage.py)
# and avatar presets (services/avatar_gallery.py) fall back to local disk /
# the single bundled preset image, respectively.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# Private bucket for memo attachments; served via 1-year signed URLs.
OSS_BUCKET=
# Public-read bucket for Settings > avatar picker presets - list objects here
# to add a new preset, no code change needed. Must have Block Public Access
# disabled (bucket-level), or public-read ACL alone will still 403.
OSS_AVATAR_BUCKET=friday-avatars

# Langfuse tracing - optional. Unset means no tracing at all (app.core.tracing).
# Self-host: git clone https://github.com/langfuse/langfuse && docker compose up,
# then create a project at http://localhost:3000 and paste its keys here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Reached over the compose network, so this is the service name - not localhost,
# which inside the backend container is the backend itself. Start the stack with
# `docker compose --profile tracing up -d`.
LANGFUSE_BASE_URL=http://langfuse-web:3000
